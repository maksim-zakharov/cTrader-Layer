{
    "compilerOptions": {
        "baseUrl": ".",
        "declaration": true,
        "incremental": true,
        "inlineSources": true,
        "module": "commonjs",
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "outDir": "build",
        "paths": {
            "!/*": [ "./*" ],
            "#*": [ "./src/core/*" ]
        },
        "removeComments": false,
        "sourceMap": true,
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es6",
        "types": ["node"],
        "plugins": [
            { "transform": "typescript-transform-paths" },
            { "transform": "typescript-transform-paths", "afterDeclarations": true }
        ]
    },
    "include": [
        "entry/**/*.ts",
        "src/**/*.ts",
        "src/shims/**/*.d.ts"
    ],
    "exclude": [ "build", "node_modules", "**/*.spec.ts", "src/core/__tests__/**" ]
}
