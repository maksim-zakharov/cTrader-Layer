{
    "compilerOptions": {
        "baseUrl": ".",
        "declaration": true,
        "incremental": true,
        "inlineSources": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "outDir": "build",
        "paths": {
            "!/*": ["./*"],
            "#*": ["./src/core/*"]
        },
        "removeComments": false,
        "sourceMap": true,
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"]
    },
    "include": [
        "entry/**/*.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "build",
        "node_modules",
        "**/*.spec.ts",
        "src/core/__tests__/**"
    ]
}
