{
    "name": "@max89701/ctrader-layer",
    "version": "2.0.0",
    "description": "A Node.js communication layer for the cTrader Open API.",
    "license": "MIT",
    "homepage": "https://github.com/maksim-zakharov/cTrader-Layer",
    "bugs": {
        "url": "https://github.com/maksim-zakharov/cTrader-Layer/issues"
    },
    "author": {
        "name": "Maksim Zakharov",
        "email": "max89701@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/maksim-zakharov/cTrader-Layer.git"
    },
    "scripts": {
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "test": "jest",
        "build": "tsup",
        "pull-proto": "node scripts/pull-proto.js",
        "safe-build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && npm run build",
        "verify:exports": "node scripts/verify-dual-exports.cjs && node scripts/verify-dual-exports.mjs",
        "prepublishOnly": "npm run typecheck && npm run test && npm run safe-build && npm run verify:exports"
    },
    "engines": {
        "node": ">=18"
    },
    "main": "./build/main.js",
    "module": "./build/main.mjs",
    "types": "./build/main.d.ts",
    "exports": {
        ".": {
            "types": "./build/main.d.ts",
            "import": "./build/main.mjs",
            "require": "./build/main.js",
            "default": "./build/main.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "build",
        "openapi-proto-messages-main",
        "PROTO_VERSION"
    ],
    "dependencies": {
        "axios": "^1.6.0",
        "protobufjs": "^7.6.6"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^20.17.30",
        "adm-zip": "^0.5.16",
        "eslint": "^9.24.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.4.12",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.29.1"
    }
}
