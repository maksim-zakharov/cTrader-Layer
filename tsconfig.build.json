{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "incremental": false,
        "declaration": true,
        "emitDeclarationOnly": false
    },
    "include": [
        "entry/**/*.ts",
        "src/**/*.ts",
        "src/shims/**/*.d.ts"
    ],
    "exclude": [
        "build",
        "node_modules",
        "**/*.spec.ts",
        "src/core/__tests__/**"
    ]
}
